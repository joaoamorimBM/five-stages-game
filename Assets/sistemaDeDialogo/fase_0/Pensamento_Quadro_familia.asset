  reportLabel: "Foto da fam\xEDlia"
  dialogueLines:
  - speaker: 0
    sentence: "Meu Deus! Que saudade desse dia..."
    choices: []
    choiceSpeaker: 0
  - speaker: 0
    sentence: "A gente tirou essa foto no anivers\xE1rio dela... tr\xEAs meses atr\xE1s."
