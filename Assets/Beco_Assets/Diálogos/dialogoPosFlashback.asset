  m_Script: {fileID: 11500000, guid: 394090b6edb3b4e30aa4a6f436724550, type: 3}
  m_Name: dialogoPosFlashback
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - speaker: 0
    sentence: Ela morreu, Emily...
  - speaker: 0
    sentence: "E n\xE3o foi culpa sua... nem minha..."
  - speaker: 0
    sentence: Isso simplesmente aconteceu...
  - speaker: 0
    sentence: "Naquele dia n\xF3s morremos junto com ela..."
  - speaker: 0
    sentence: Mas continuamos respirando...
  - speaker: 0
    sentence: Precisamos viver por ela... Amar por ela... Sorrir por ela...
  - speaker: 9
    sentence: Precisamos nos despedir.
  - speaker: 2
    sentence: "Essa dor nunca vai parar... n\xE3o \xE9?"
  - speaker: 0
    sentence: Sim... vamos pra casa.
