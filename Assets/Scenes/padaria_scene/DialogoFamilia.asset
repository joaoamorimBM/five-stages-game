  m_Script: {fileID: 11500000, guid: 394090b6edb3b4e30aa4a6f436724550, type: 3}
  m_Name: DialogoFamilia
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - speaker: 6
    sentence: Bom dia! Tudo bem?
  - speaker: 5
    sentence: Bom dia, sejam bem-vindos!
  - speaker: 6
    sentence: "Quer\xEDamos o caf\xE9 da manh\xE3 completo, por favor."
  - speaker: 7
    sentence: EU QUERO ACHOCOLATADO, PAPAI!
  - speaker: 6
    sentence: "Calma, filha. Precisamos ter educa\xE7\xE3o. Com licen\xE7a... vem
      achocolatado no caf\xE9 da manh\xE3 completo?"
  - speaker: 5
    sentence: "Infelizmente n\xE3o, seria necess\xE1rio pedir separado."
  - speaker: 7
    sentence: EU QUERO, PAPAI! POR FAVOR!
  - speaker: 7
    sentence: POR FAVOR, PAPAI!
  - speaker: 4
    sentence: POR FAVOR, PAPAI...
  - speaker: 4
    sentence: POR FAVOR... ME SALVA.
