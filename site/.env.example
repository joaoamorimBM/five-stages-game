# Copie para .env.local e preencha com os dados do projeto (Painel → Project Settings → API).
# Use a chave PÚBLICA (anon / publishable). A service role NUNCA entra aqui.
# Sem essas variáveis o site abre em modo demonstração, com dados de exemplo.
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_publica
